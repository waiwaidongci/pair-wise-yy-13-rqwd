{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 62012",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 62012",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run smoke:rules && npm run smoke:repo && npm run smoke:render",
    "smoke:rules": "esbuild scripts/smoke-rules.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-rules.mjs && node node_modules/.cache/smoke-rules.mjs",
    "smoke:repo": "esbuild scripts/smoke-repo.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-repo.mjs && node node_modules/.cache/smoke-repo.mjs",
    "smoke:render": "esbuild scripts/render-smoke.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-render.cjs && node node_modules/.cache/smoke-render.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
